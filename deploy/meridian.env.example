# Meridian v2 — the single source of service configuration (ADR-003 §0).
# Deployed to /etc/meridian/meridian.env; every service reads ONLY from here.
# Copy to meridian.env, fill the secrets, and DO NOT commit the filled copy.

# --- Database (Inferno) — pgvector container, see deploy/docker-compose.yml ----
# POSTGRES_PASSWORD is consumed by docker-compose; keep it == the password in
# DATABASE_URL. Host port 5544 avoids Inferno's native pg (frozen v1) on 5432.
# Local dev: point DATABASE_URL at localhost:5544 with the same container.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://meridian:CHANGE_ME@192.168.0.28:5544/meridian

# --- Embedder ----------------------------------------------------------------
# Pinned and validated at service start against the schema's vector(N) column.
# A mismatch here is a STARTUP FAILURE, not silent data corruption (item 9).
EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_EMBED_URL=http://192.168.0.28:11434/api/embeddings

# --- MQTT (mosquitto on Inferno; Sensor Pi bridges its local broker to this) --
MQTT_HOST=192.168.0.28
MQTT_PORT=1883

# --- Relay (LISTEN/NOTIFY -> WebSocket; keeps the v1 ws-bridge contract) ------
RELAY_HOST=0.0.0.0
RELAY_PORT=8765
NOTIFY_CHANNEL=perceptual_events

# --- Spool (Sensor Pi .25 only; ignored elsewhere) ----------------------------
# The spool SUBSCRIBES to the local broker and FORWARDS upstream to MQTT_HOST
# above (Inferno). On the Pi, set MQTT_HOST=192.168.0.28 and leave these local.
SPOOL_LOCAL_MQTT_HOST=localhost
SPOOL_LOCAL_MQTT_PORT=1883
SPOOL_DB_PATH=/var/lib/meridian/spool.db

# --- Promotion gates (Slice B; here so meridian.env is the whole story) -------
PROMOTION_MIN_MEMBERS=12
PROMOTION_MIN_SPAN_HOURS=72
PROMOTION_MIN_SOURCES=2
PROMOTION_STABILITY_EPSILON=0.05

# --- Retention (ADR-003 §5.2; raws backing unresolved candidates never reaped) -
RAW_RETENTION_DAYS=90
