.telemetry-card {
    background-color: rgba(30, 30, 30, 0.85);
    border-radius: 8px;
    padding: 12px;
    margin: 8px;
    border-width: 1px;
    border-color: rgba(0, 255, 204, 0.5);
    width: 250px;
    align-self: flex-start;
}

.card-title {
    color: rgb(200, 200, 200);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.card-value {
    color: rgb(0, 255, 204);
    font-size: 18px;
}
